# ==============================================================================
# Enterprise AI Research & Automation Agent - Environment Configuration
# ==============================================================================

# LLM & OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Security & Authentication
SECRET_KEY=super-secret-enterprise-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database Configuration
# Defaults to SQLite locally; set to PostgreSQL for Docker/Production:
DATABASE_URL=sqlite:///./enterprise_ai.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/enterprise_ai_db

# Chroma Vector Database
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=enterprise_knowledge_base

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
